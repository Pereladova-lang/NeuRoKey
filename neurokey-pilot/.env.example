DATABASE_URL="file:./dev.db"
AUTH_SECRET="replace-with-random-secret"

# Robokassa (see src/lib/robokassa.ts). Without these, checkout returns 503
# unless BILLING_MOCK=1.
ROBOKASSA_MERCHANT_LOGIN=
ROBOKASSA_PASSWORD1=
ROBOKASSA_PASSWORD2=
ROBOKASSA_IS_TEST=true
# 1 = /api/billing/checkout returns a mock success URL instead of calling
# Robokassa; trigger the webhook manually to simulate a payment in dev.
BILLING_MOCK=
